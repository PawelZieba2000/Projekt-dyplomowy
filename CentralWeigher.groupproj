    <Target Name="CentralWeigherServer:Make">
        <MSBuild Projects="SERVER\sources\project\CentralWeigherServer.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="CentralWeigherClient;CentralWeigherServer"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="CentralWeigherClient:Clean;CentralWeigherServer:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="CentralWeigherClient:Make;CentralWeigherServer:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
